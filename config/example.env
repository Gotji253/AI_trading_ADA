# Example environment variables for AI_trading_ADA
# Copy to .env and fill in your keys

# LLM Provider (OpenRouter, OpenAI, etc.)
OPENROUTER_API_KEY=

# Exchange / Data APIs (paper trading recommended)
BINANCE_API_KEY=
BINANCE_API_SECRET=
# or CoinGecko, etc.

# Cardano specific (optional)
# BLOCKFROST_API_KEY=

# Risk parameters
MAX_POSITION_PCT=5
DEFAULT_STOP_LOSS_PCT=3
DEFAULT_TAKE_PROFIT_PCT=6

# Mode
TRADING_MODE=paper
