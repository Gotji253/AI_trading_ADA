# ============================================
# AI_trading_ADA — Environment Configuration
# Copy this file to .env and fill in your keys
# ============================================

# ---- Binance (recommended) ----
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ---- LLM for AI Analysis (choose one) ----
# OpenRouter (recommended — many models)
OPENROUTER_API_KEY=

# or OpenAI
# OPENAI_API_KEY=

# ---- Trading Settings ----
TRADING_MODE=paper
MAX_POSITION_PCT=5
DEFAULT_STOP_LOSS_PCT=3
DEFAULT_TAKE_PROFIT_PCT=6
