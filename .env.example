# ============================================
# AI_trading_ADA — Environment Configuration
# ============================================

# ---- Binance (recommended) ----
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ---- LLM for AI Analysis ----
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# ---- Telegram Notification ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Trading / Risk Settings ----
TRADING_MODE=paper

# Risk per trade (blueprint: 1.0%)
RISK_PER_TRADE_PCT=1.0

# Daily loss limit (blueprint: 3.0%)
DAILY_LOSS_LIMIT_PCT=3.0

# Max drawdown hard stop (blueprint: 10.0%)
MAX_DRAWDOWN_HARD_STOP_PCT=10.0

MAX_DAILY_TRADES=5

# Distance to support/resistance to consider "near" (percent)
SR_PROXIMITY_PCT=1.5

DEFAULT_STOP_LOSS_PCT=2.5
DEFAULT_TAKE_PROFIT_PCT=5.0
