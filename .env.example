# ============================================
# AI Trading System — Multi-Asset Configuration
# ============================================

# ---- Trading Universe (Improved) ----
TRADING_ASSETS=BTCUSDT,ETHUSDT,BNBUSDT

# ---- Binance ----
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ---- LLM (optional) ----
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# ---- Telegram (optional) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Trading / Risk ----
TRADING_MODE=paper
INITIAL_EQUITY=10000

RISK_PER_TRADE_PCT=1.0
DAILY_LOSS_LIMIT_PCT=3
MAX_DRAWDOWN_HARD_STOP_PCT=12

MAX_OPEN_POSITIONS=2
MAX_DAILY_TRADES=3

# ---- Real-time ----
CHECK_INTERVAL_SECONDS=300

# ---- Strategy ----
ADX_THRESHOLD=25
MIN_HOLD_DAYS=7
USE_BTC_TREND_FILTER=true
