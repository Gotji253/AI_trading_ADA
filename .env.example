# ============================================
# AI_trading_ADA — Environment Configuration
# Copy this file to .env and fill in your keys
# ============================================

# ---- Binance (recommended) ----
# Get keys at: https://www.binance.com/en/my/settings/api-management
# Enable "Enable Reading" and (optional) "Enable Spot & Margin Trading"
# For safety: start with Read-only key, or use Testnet
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ---- Optional: CoinGecko Pro (not required for free tier) ----
# COINGECKO_API_KEY=

# ---- LLM Provider (Hermes usually manages this separately) ----
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=

# ---- Trading Settings ----
# paper = analysis + simulated only (default, safe)
# live  = real orders (requires trading permission on Binance key + explicit confirmation)
TRADING_MODE=paper

# Risk parameters
MAX_POSITION_PCT=5
DEFAULT_STOP_LOSS_PCT=3
DEFAULT_TAKE_PROFIT_PCT=6
