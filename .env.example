# ============================================
# AI_trading_ADA — Environment Configuration
# ============================================

# ---- Binance (recommended) ----
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ---- LLM for AI Analysis ----
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# ---- Telegram Notification ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Trading / Risk Settings ----
TRADING_MODE=paper

# Risk per trade (1% - 2% of equity)
RISK_PER_TRADE_PCT=1.5

# Daily loss limit (3% - 5%)
DAILY_LOSS_LIMIT_PCT=4

# Max drawdown hard stop (10% - 15%) → auto emergency / quarantine
MAX_DRAWDOWN_HARD_STOP_PCT=12

MAX_DAILY_TRADES=5

# Distance to support/resistance to consider "near" (percent)
SR_PROXIMITY_PCT=1.5

DEFAULT_STOP_LOSS_PCT=3
DEFAULT_TAKE_PROFIT_PCT=6
