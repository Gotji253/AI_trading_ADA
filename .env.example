# ============================================
# AI_trading_ADA — Environment Configuration
# Copy this file to .env and fill in your keys
# ============================================

# ---- Binance (recommended) ----
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ---- LLM for AI Analysis ----
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# ---- Telegram Notification ----
# 1. Create bot with @BotFather → get token
# 2. Send any message to your bot, then get chat_id from:
#    https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Trading Settings ----
TRADING_MODE=paper
MAX_POSITION_PCT=5
MAX_DAILY_TRADES=5
DEFAULT_STOP_LOSS_PCT=3
DEFAULT_TAKE_PROFIT_PCT=6
