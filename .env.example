# ============================================
# AI_trading_ADA — Environment Configuration
# Copy this file to .env and fill in your keys
# ============================================

# ---- Binance (recommended) ----
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ---- LLM for AI Analysis ----
# OpenRouter (recommended)
OPENROUTER_API_KEY=

# Free model by default (no cost)
# Other free options:
#   google/gemma-2-9b-it:free
#   mistralai/mistral-7b-instruct:free
#   microsoft/phi-3-mini-128k-instruct:free
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# Optional: OpenAI (if you prefer)
# OPENAI_API_KEY=

# ---- Trading Settings ----
TRADING_MODE=paper
MAX_POSITION_PCT=5
DEFAULT_STOP_LOSS_PCT=3
DEFAULT_TAKE_PROFIT_PCT=6
