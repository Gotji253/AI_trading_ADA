# ============================================
# AI_trading_ADA — Environment Configuration
# ============================================

# ---- Binance (recommended) ----
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ---- LLM for AI Analysis ----
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# ---- Telegram Notification ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Trading / Risk Settings ----
TRADING_MODE=paper

RISK_PER_TRADE_PCT=1.5
DAILY_LOSS_LIMIT_PCT=4
MAX_DRAWDOWN_HARD_STOP_PCT=12

# New risk controls
MAX_OPEN_RISK_PCT=3.0
CONSECUTIVE_LOSS_LIMIT=3
LOSS_COOLDOWN_MINUTES=30

MAX_DAILY_TRADES=5
SR_PROXIMITY_PCT=1.5

DEFAULT_STOP_LOSS_PCT=2.5
DEFAULT_TAKE_PROFIT_PCT=5.0

# ---- Regime Agent Thresholds ----
REGIME_TREND_THRESHOLD=3.5
REGIME_VOL_HIGH=4.5
REGIME_RANGE_HIGH=2.8
REGIME_RANGING_THRESHOLD=1.8
